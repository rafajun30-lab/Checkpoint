# Copie este arquivo para ".env" e ajuste se necessário.
# Esses valores já correspondem ao docker-compose.yml fornecido.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meteo_db

# Alternativa: definir a URL completa de uma vez (tem prioridade sobre as acima)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/meteo_db
